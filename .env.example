# OutdoorPal environment template. Copy to .env and fill in.
# Only HF_TOKEN is required to enable the live SLM. Without it the
# assistant falls back to a deterministic template (still grounded).

# Next.js / Prisma (default scaffold value — do not change)
DATABASE_URL=file:./db/custom.db

# IPv4-first DNS (recommended on sandbox / container hosts where IPv6
# egress is blocked by the firewall)
NODE_OPTIONS=--dns-result-order=ipv4first

# Hugging Face Inference API token (free, read scope)
# Get one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Model identifier (must be an open SLM <= 3B params). Defaults to
# Qwen2.5-1.5B-Instruct. Swap for any other open SLM you prefer.
HF_MODEL=Qwen/Qwen2.5-1.5B-Instruct
